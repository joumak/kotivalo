[Unit]
Description=Wakeup light (zigpy sunrise alarm)
Wants=network-online.target
After=network-online.target time-sync.target

[Service]
# The service reports READY once the radio and web UI are up, then pings the watchdog;
# a hang (even on the way out after an error) makes systemd kill and restart it.
Type=notify
NotifyAccess=main
WatchdogSec=60
TimeoutStartSec=90
User=pi
Group=pi
SupplementaryGroups=dialout
WorkingDirectory=/home/pi/wakeup-light
ExecStart=/home/pi/wakeup-light/.venv/bin/wakeup-light --state-dir /var/lib/wakeup-light serve --host 0.0.0.0 --port 8080
Environment=PYTHONUNBUFFERED=1
StateDirectory=wakeup-light
Restart=on-failure
RestartSec=10
# Exit 78 = bad configuration: restarting won't help.
RestartPreventExitStatus=78
TimeoutStopSec=20
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
